[Unit]
Description=Owldrop — Tailscale file sharing desktop app
After=graphical-session.target

[Service]
Type=simple
# Optional env vars for future use; the "-" means a missing file is fine.
EnvironmentFile=-%h/.config/owldrop/env
ExecStart=%h/.local/share/owldrop/app/bin/owldrop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
